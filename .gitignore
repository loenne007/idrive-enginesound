# BMW's SDK: extract it from your own head unit (kit/tools/extract_sdk.js), never commit it
oap-sdk
# the unit's SOME/IP catalog (copied from your unit for kit/tools/check_signals.py)
reference/
# build output: every package contains BMW's SDK, so don't publish these either
dist/
*.mgu
*.tgz
# app previews (kit/tools/preview.js)
/preview/
# the sound engines' build folders (each synth/<id>/.gitignore too)
synth/*/build/
# local stuff
*.pem
*.key
*.log
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store
.claude/
