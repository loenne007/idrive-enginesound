{
  "id": "lfb-enginesound",
  "kind": "tool",
  "version": "0.9.0",
  "title": "Engine Sound service",
  "description": "Synthesizes the engine sound (inline-6, V8, V10, V12) live from the car's rpm, gear and load and plays it on the car's speakers through SmartX; several sound engines to compare; driven by the Engine Sound app",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "files": [
    {
      "path": "es-synth-a",
      "mode": "0755"
    },
    {
      "path": "es-synth-b",
      "mode": "0755"
    },
    {
      "path": "es-synth-d",
      "mode": "0755"
    },
    {
      "path": "esd.js",
      "mode": "0644"
    },
    {
      "path": "check.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "lfb-enginesound.service"
    }
  ],
  "enable": [
    {
      "unit": "lfb-enginesound.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "lfb-enginesound.service"
  ],
  "check": [
    "check.js"
  ]
}
